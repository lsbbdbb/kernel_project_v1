services:
  agent:
    build:
      context: .
      dockerfile: Dockerfile
    volumes:
      - .:/app
      - ./kernel-src:/kernel-src
    working_dir: /app
    environment:
      - KERNEL_SRC=/kernel-src/linux-6.6.102-5.2.an23.x86_64
    # Default: run tests via entrypoint
    command: ["test"]

  agent-dev:
    build:
      context: .
      dockerfile: Dockerfile
    volumes:
      - .:/app
      - ./kernel-src:/kernel-src
    working_dir: /app
    environment:
      - KERNEL_SRC=/kernel-src/linux-6.6.102-5.2.an23.x86_64
    stdin_open: true
    tty: true
    # Interactive shell via entrypoint
    command: ["shell"]

  agent-run:
    build:
      context: .
      dockerfile: Dockerfile
    volumes:
      - .:/app
      - ./kernel-src:/kernel-src
      - agent-output:/tmp/test_workspace
    working_dir: /app
    environment:
      - KERNEL_SRC=/kernel-src/linux-6.6.102-5.2.an23.x86_64
      - WORKDIR=/tmp/test_workspace
    # Run agent via entrypoint
    command: ["run"]

volumes:
  agent-output:
